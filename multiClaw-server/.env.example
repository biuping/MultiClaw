# MultiClaw Server 环境变量配置
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=3010

# API 认证密钥（生产环境务必修改！）
API_KEY=multiclaw-dev-key-change-me

# CORS 允许的来源（逗号分隔，* 表示全部允许）
CORS_ORIGIN=http://localhost:3000,http://localhost:3010

# Agent Workspace 根目录
WORKSPACE_ROOT=/Users/biuping/code/multiClaw/workspace

# OpenClaw 网关地址
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:4567

# 速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60

# 对话接口速率限制（每分钟请求数）
CHAT_RATE_LIMIT_PER_MINUTE=10
